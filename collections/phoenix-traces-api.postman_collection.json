        {
          "id": "678d811e-8dc2-45fd-8ca1-ec403a5a964f",
          "name": "Create a trace note",
          "request": {
            "name": "Create a trace note",
            "description": {
              "content": "Add a note annotation to a trace. By default each call appends a new note with an auto-generated UUIDv4 identifier, so multiple notes accumulate on the same trace. Callers may supply a non-empty `identifier` to upsert on (trace_id, name='note', identifier) — repeated calls with the same identifier overwrite the existing note, matching the semantics of structured annotations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "trace_notes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"trace_id\": \"<string>\",\n    \"note\": \"<string>\",\n    \"identifier\": \"\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
